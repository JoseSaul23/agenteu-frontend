sers\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\InstitutionInMenu.js",["176"],"import React, {Component} from 'react'\r\nimport logo from '../logo.png'\r\n\r\nexport class InstitutionInMenu extends Component {\r\n    render () {\r\n      const {name, logo_img, overall_difficulty, overall_rating, reviews_count} = this.props\r\n      return (\r\n        <div className=\"institutionMenu-wrapper column is-one-quarter mb-5\">\r\n          <img src={logo} alt=\"logo\"/>\r\n          <div className=\"columns is-mobile\"> \r\n            <div className=\"column is-two-thirds has-text-weight-medium institutionMenu-info\">\r\n              <div>\r\n                <p>{name}</p>\r\n              </div>\r\n              <div className=\"institutionMenu-reviews\">\r\n                <p>{reviews_count} Reseñas</p>\r\n              </div>\r\n            </div> \r\n            <div className=\"column has-text-centered\">\r\n              <div>\r\n                <p className=\"institution-labels\">calificación</p>\r\n                <p>{overall_rating? overall_rating : \"N/A\"}</p>\r\n              </div>\r\n              <div className=\"mt-1\">\r\n                <p className=\"institution-labels\">dificultad</p>\r\n                <p>{overall_difficulty? overall_difficulty + \"%\": \"N/A\"}</p>\r\n              </div>\r\n            </div> \r\n          </div>\r\n        </div>\r\n      );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\TopReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\ProfessorInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\Register.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\Login.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\SearchResults.js",["177","178"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\University.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\age