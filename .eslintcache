                 location={this.props.location}\r\n                            />\r\n                        </div>\r\n                        {/* LISTAS */}\r\n                        <Switch>\r\n                            <Route  \r\n                                exact\r\n                                path={this.props.match.path}\r\n                                render={(props) => (\r\n                                    <div className=\"column is-four-fifths is-offset-1 mt-2\">\r\n                                        <ReviewsList {...props} entity={entity}/>\r\n                                    </div>\r\n                                )} \r\n                            />\r\n                            {entity === \"universidades\" || entity ===\"escuelas\"\r\n                                ?   <Route \r\n                                        path={this.props.match.path + \"/profesores\"}\r\n                                        render={(props) => (\r\n                                            <div className=\"column is-two-fifths is-offset-1\">\r\n                                                <ProfessorsList {...props} entity={entity}/>\r\n                                            </div>\r\n                                        )} \r\n                                    />\r\n                                :   <Route component={RedirectAs404}/>\r\n                                }\r\n                            {entity === \"universidades\" \r\n                                ?   <Route \r\n                                        path={this.props.match.path + \"/escuelas\"}\r\n                                        render={(props) => (\r\n                                            <div className=\"column is-four-fifths is-offset-1 mt-2\">\r\n                                                <SchoolsList {...props} />\r\n                                            </div>\r\n                                        )} \r\n                                    />\r\n                                :   <Route component={RedirectAs404}/>\r\n                            }\r\n                            <Route component={RedirectAs404}/>\r\n                        </Switch>\r\n                    </div>\r\n                </div>\r\n                {/* PANEL DERECHO */}\r\n                <RightPanel/>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RightPanel.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\ProfileNavBar.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MasterWrapper.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\store.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\util.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\index.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\authReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\errorReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\types.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\authActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\errorActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\PrivateRoute.js",["332"],"import React from 'react'\r\nimport {Route, Redirect} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\n\r\nconst PrivateRoute = ({ component: Component, auth, ...rest}) =>(\r\n    <Route \r\n        {...rest}\r\n        render= {(props) => {\r\n            if (auth.isLoading) {\r\n                return <div></div>\r\n            }\r\n            else if (!auth.isAuthenticated) {\r\n                return <Redirect to=\"/iniciar-sesion\"/>\r\n            }\r\n            else {\r\n                return <Component {...props}/>\r\n            }\r\n        }}\r\n    />\r\n);\r\n\r\n\r\nconst mapStateToProps = (state) => ({\r\n    auth: state.auth\r\n})\r\n\r\nexport default connect(mapStateToProps)(PrivateRoute)","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\reviewReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\reviewActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityDetailsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityDetailsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\EditReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserListReviews.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\notificationReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\Notification.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\notificationsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\userFeedReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\userFeedActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\LikelyProfessor.js",[],["333","334"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\LikelyProfessorsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserSettings.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\SubscriptionProfessor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SubscriptionSchool.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\SubscriptionUniversity.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\SubscriptionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\subscriptionsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\subscriptionsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPassword.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPasswordConfirmation.js",["335","336"],"import React, {Component} from 'react'\r\nimport logoicono from '../../logo-icono.png'\r\nimport {Redirect, Link} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\nimport {resetPasswordConfirm} from '../actions/authActions'\r\nimport {clearErrors} from '../actions/errorActions'\r\n\r\nexport class ResetPasswordConfirmation extends Component {\r\n\r\n    state = {\r\n        uid: '',\r\n        token: '',\r\n        new_password: '',\r\n    }\r\n\r\n    static propTypes = {\r\n        isAuthenticated: PropTypes.bool,\r\n        error: PropTypes.object.isRequired,\r\n        resetPasswordConfirm: PropTypes.func.isRequired,\r\n        clearErrors: PropTypes.func.isRequired,\r\n    }\r\n\r\n    _handleSubmit = (e) => {\r\n        e.preventDefault();\r\n        const {uid, token, new_password} = this.state\r\n        this.props.resetPasswordConfirm(uid, token, new_password)\r\n    }\r\n\r\n    _handleChange = (e) => {\r\n        this.setState({ [e.target.name]: e.target.value });\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearErrors()\r\n    }\r\n\r\n    render () {\r\n        if (this.props.isAuthenticated){\r\n            return <Redirect to=\"/\" />\r\n        }\r\n\r\n        const {email} = this.state\r\n        const {error} = this.props\r\n\r\n        return (\r\n            <section className=\"section pt-3\">\r\n            <div className=\"container\">\r\n            <div className=\"columns is-centered\">\r\n            <div className=\"column is-two-fifths\">\r\n                <div className=\"has-text-centered\">\r\n                    <img src={logoicono} alt=\"logoicono\" width=\"100\" height=\"100\"/>\r\n                </div>\r\n                <div>\r\n                    <div className=\"ml-2 mr-5 mb-5 mt-0\">\r\n                        <h4 className=\"title is-4\">Ingresa tu nueva contraseña</h4>\r\n                    </div>\r\n                    <form onSubmit={this._handleSubmit}>\r\n                        <div className=\"field\">\r\n                            <p className=\"control\">\r\n                                <input\r\n                                    className=\"input is-medium\"\r\n                                    type=\"password\"\r\n                                    placeholder=\"nueva contraseña\"\r\n                                    name=\"new_password\"\r\n                                    onChange={this._handleChange}\r\n                                />\r\n                            </p>\r\n                            <p className=\"has-text-danger\">\r\n                                {error.message.new_password ? error.message.new_password : '' }\r\n                            </p>\r\n                        </div>\r\n                        <div className=\"field mt-5 is-grouped is-grouped-centered\">\r\n                            <div className=\"buttons\">\r\n                                <button type=\"submit\" className=\"button is-link is-medium has-text-white has-text-weight-bold\">\r\n                                    Cambiar contraseña\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n            </div>\r\n            </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    isAuthenticated : state.auth.isAuthenticated,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(mapStateToProps, { resetPasswordConfirm, clearErrors })(ResetPasswordConfirmation);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Embed.js",["337"],"import React, {Component} from 'react'\r\nimport Review from './Review'\r\nimport RightPanel from '../common/RightPanel'\r\nimport {connect} from 'react-redux'\r\nimport {getReview, clearReview} from '../actions/reviewActions'\r\nimport PropTypes from 'prop-types'\r\nimport {RedirectAs404} from '../common/RedirectAs404'\r\n\r\n\r\nexport class Embed extends Component {\r\n\r\n    static propTypes = {\r\n        getReview: PropTypes.func.isRequired,\r\n        review: PropTypes.object.isRequired,\r\n        isLoading: PropTypes.bool,\r\n        clearReview: PropTypes.func.isRequired,\r\n        error: PropTypes.object.isRequired,\r\n    }\r\n\r\n    componentDidMount() {\r\n        const {id} = this.props.match.params\r\n        this.props.getReview(id)\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearReview()\r\n    }\r\n\r\n    render() {\r\n\r\n        if (this.props.error.status === 404) {\r\n            return <RedirectAs404 location={this.props.location}/>\r\n        }\r\n\r\n        const {review} = this.props\r\n\r\n        return(\r\n        <div className=\"columns is-centered mt-6 pt-6 ml-0 mr-0\">\r\n            <div className=\"column is-full\">\r\n                {\r\n                    this.props.isLoading ?\r\n                    <div className=\"columns\">\r\n                        <div className=\"column has-text-centered\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                    </div> :\r\n                    <Review \r\n                        id={review.id}\r\n                        text={review.text}\r\n                        rating={review.rating}\r\n                        difficulty={review.difficulty}\r\n                        date={review.date}\r\n                        user={review.user}\r\n                        user_name={review.user_name}\r\n                        entity={review.entity}\r\n                        entity_name={review.entity_name}\r\n                        entity_type={review.entity_type}\r\n                        recomendations_count={review.recomendations_count}\r\n                        recomendations={review.recomendations}\r\n                        favorite={review.favorite}\r\n                    />\r\n                }\r\n            </div>\r\n        </div>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    review: state.reviews.review,\r\n    isLoading: state.reviews.isLoading,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(\r\n    mapStateToProps, \r\n    {getReview, clearReview}\r\n)(Embed);",["338","339"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewDetail.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MenuMobile.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Page404.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\messageReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\messageActions.js",[],{"ruleId":"340","replacedBy":"341"},{"ruleId":"342","replacedBy":"343"},{"ruleId":"344","severity":1,"message":"345","line":18,"column":16,"nodeType":"346","messageId":"347","endLine":18,"endColumn":18},{"ruleId":"344","severity":1,"message":"348","