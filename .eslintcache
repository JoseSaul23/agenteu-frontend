op\\Git\\agenteu-frontend\\src\\components\\reducers\\errorReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\types.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\authActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\errorActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\PrivateRoute.js",["324"],"import React from 'react'\r\nimport {Route, Redirect} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\n\r\nconst PrivateRoute = ({ component: Component, auth, ...rest}) =>(\r\n    <Route \r\n        {...rest}\r\n        render= {(props) => {\r\n            if (auth.isLoading) {\r\n                return <div>Cargando...RUTA PRIVADA</div>\r\n            }\r\n            else if (!auth.isAuthenticated) {\r\n                return <Redirect to=\"/iniciar-sesion\"/>\r\n            }\r\n            else {\r\n                return <Component {...props}/>\r\n            }\r\n        }}\r\n    />\r\n);\r\n\r\n\r\nconst mapStateToProps = (state) => ({\r\n    auth: state.auth\r\n})\r\n\r\nexport default connect(mapStateToProps)(PrivateRoute)","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\reviewReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\reviewActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityDetailsReducer.js",["325","326"],"import {\r\n    ENTITY_LOADING,\r\n    GET_ENTITY,\r\n    CLEAR_ENTITY,\r\n    REVIEW_BY_USER_LOADED,\r\n    CLEAR_REVIEW_BY_USER,\r\n    SUBSCRIBE_TO_ENTITY\r\n} from '../actions/types'\r\n\r\nconst initialState = {\r\n    entity: {},\r\n    entityIsLoading: false,\r\n    reviewByUser: {},\r\n}\r\n\r\nexport const entityDetailsReducer = (state=initialState, action) => {\r\n    switch(action.type){\r\n        case ENTITY_LOADING:\r\n            return {\r\n                ...state,\r\n                entityIsLoading: true\r\n            }\r\n        case GET_ENTITY:\r\n            return {\r\n                ...state,\r\n                entity: action.payload,\r\n                entityIsLoading: false\r\n            }\r\n        case CLEAR_ENTITY:\r\n            return {\r\n                ...state,\r\n                entity: {}\r\n            }\r\n        case SUBSCRIBE_TO_ENTITY:\r\n            return {\r\n                ...state,\r\n                entity: action.payload\r\n            }\r\n        default:\r\n            return state\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityDetailsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\EditReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserListReviews.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\notificationReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\Notification.js",["327","328"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\notificationsActions.js",["329"],"import {GET_NOTIFICATIONS, DELETE_NOTIFICATION, CHECK_NOTIFICATION, CLEAR_NOTIFICATIONS, GET_ERRORS} from './types'\r\nimport {tokenConfig, getUser} from './authActions'\r\nimport axios from 'axios'\r\n\r\nexport const getNotifications = () => (dispatch, getState) => {\r\n    // Petición HTTP a la API para obtener notificaciones del usuario autenticado.\r\n    axios.get(`http://localhost:8000/api/notificaciones/`, tokenConfig(getState))\r\n    .then( res => {\r\n        dispatch({ \r\n            type: GET_NOTIFICATIONS,\r\n            payload: res.data\r\n        });\r\n    })\r\n    .catch( e => {\r\n        const errors = {message: e.response.data, status: e.response.status}\r\n        dispatch( {\r\n            type: GET_ERRORS,\r\n            payload: errors\r\n        })\r\n    })\r\n}\r\n\r\nexport const deleteNotification = (id) => (dispatch, getState) => {\r\n    // Petición HTTP a la API para borrar notificacione del usuario autenticado.\r\n    axios.delete(`http://localhost:8000/api/notificaciones/${id}/`, tokenConfig(getState))\r\n    .then( res => {\r\n        dispatch({ \r\n            type: DELETE_NOTIFICATION,\r\n            payload: id\r\n        });\r\n    })\r\n    .catch( e => {\r\n        const errors = {message: e.response.data, status: e.response.status}\r\n        dispatch( {\r\n            type: GET_ERRORS,\r\n            payload: errors\r\n        })\r\n    })\r\n}\r\n\r\nexport const checkNotification = (id) => (dispatch, getState) => {\r\n    // Petición HTTP a la API para borrar notificacione del usuario autenticado.\r\n    axios.get(`http://localhost:8000/api/notificaciones/${id}/check_notification/`, tokenConfig(getState))\r\n    .then( res => {\r\n        dispatch({ \r\n            type: CHECK_NOTIFICATION,\r\n            payload: res.data\r\n        });\r\n    })\r\n    .catch( e => {\r\n        const errors = {message: e.response.data, status: e.response.status}\r\n        dispatch( {\r\n            type: GET_ERRORS,\r\n            payload: errors\r\n        })\r\n    })\r\n}\r\n\r\n\r\nexport const clearNotifications = () => (dispatch) => {\r\n    dispatch({\r\n        type: CLEAR_NOTIFICATIONS\r\n    })\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\userFeedReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\userFeedActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\LikelyProfessor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\LikelyProfessorsList.js",["330"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserSettings.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\SubscriptionProfessor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SubscriptionSchool.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\SubscriptionUniversity.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\SubscriptionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\subscriptionsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\subscriptionsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPassword.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPasswordConfirmation.js",["331","332"],"import React, {Component} from 'react'\r\nimport logoicono from '../../logo-icono.png'\r\nimport {Redirect, Link} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\nimport {resetPasswordConfirm} from '../actions/authActions'\r\nimport {clearErrors} from '../actions/errorActions'\r\n\r\nexport class ResetPasswordConfirmation extends Component {\r\n\r\n    state = {\r\n        uid: '',\r\n        token: '',\r\n        new_password: '',\r\n    }\r\n\r\n    static propTypes = {\r\n        isAuthenticated: PropTypes.bool,\r\n        error: PropTypes.object.isRequired,\r\n        resetPasswordConfirm: PropTypes.func.isRequired,\r\n        clearErrors: PropTypes.func.isRequired,\r\n    }\r\n\r\n    _handleSubmit = (e) => {\r\n        e.preventDefault();\r\n        const {uid, token, new_password} = this.state\r\n        this.props.resetPasswordConfirm(uid, token, new_password)\r\n    }\r\n\r\n    _handleChange = (e) => {\r\n        this.setState({ [e.target.name]: e.target.value });\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearErrors()\r\n    }\r\n\r\n    render () {\r\n        if (this.props.isAuthenticated){\r\n            return <Redirect to=\"/\" />\r\n        }\r\n\r\n        const {email} = this.state\r\n        const {error} = this.props\r\n\r\n        return (\r\n            <section className=\"section pt-3\">\r\n            <div className=\"container\">\r\n            <div className=\"columns is-centered\">\r\n            <div className=\"column is-two-fifths\">\r\n                <div className=\"has-text-centered\">\r\n                    <img src={logoicono} alt=\"logoicono\" width=\"100\" height=\"100\"/>\r\n                </div>\r\n                <div>\r\n                    <div className=\"ml-2 mr-5 mb-5 mt-0\">\r\n                        <h4 className=\"title is-4\">Ingresa tu nueva contraseña</h4>\r\n                    </div>\r\n                    <form onSubmit={this._handleSubmit}>\r\n                        <div className=\"field\">\r\n                            <p className=\"control\">\r\n                                <input\r\n                                    className=\"input is-medium\"\r\n                                    type=\"password\"\r\n                                    placeholder=\"nueva contraseña\"\r\n                                    name=\"new_password\"\r\n                                    onChange={this._handleChange}\r\n                                />\r\n                            </p>\r\n                            <p className=\"has-text-danger\">\r\n                                {error.message.new_password ? error.message.new_password : '' }\r\n                            </p>\r\n                        </div>\r\n                        <div className=\"field mt-5 is-grouped is-grouped-centered\">\r\n                            <div className=\"buttons\">\r\n                                <button type=\"submit\" className=\"button is-link is-medium has-text-white has-text-weight-bold\">\r\n                                    Cambiar contraseña\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n            </div>\r\n            </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    isAuthenticated : state.auth.isAuthenticated,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(mapStateToProps, { resetPasswordConfirm, clearErrors })(ResetPasswordConfirmation);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Embed.js",["333"],"import React, {Component} from 'react'\r\nimport Review from './Review'\r\nimport RightPanel from '../common/RightPanel'\r\nimport {connect} from 'react-redux'\r\nimport {getReview, clearReview} from '../actions/reviewActions'\r\nimport PropTypes from 'prop-types'\r\nimport {RedirectAs404} from '../common/RedirectAs404'\r\n\r\n\r\nexport class Embed extends Component {\r\n\r\n    static propTypes = {\r\n        getReview: PropTypes.func.isRequired,\r\n        review: PropTypes.object.isRequired,\r\n        isLoading: PropTypes.bool,\r\n        clearReview: PropTypes.func.isRequired,\r\n        error: PropTypes.object.isRequired,\r\n    }\r\n\r\n    componentDidMount() {\r\n        const {id} = this.props.match.params\r\n        this.props.getReview(id)\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearReview()\r\n    }\r\n\r\n    render() {\r\n\r\n        if (this.props.error.status === 404) {\r\n            return <RedirectAs404 location={this.props.location}/>\r\n        }\r\n\r\n        const {review} = this.props\r\n\r\n        return(\r\n        <div className=\"columns is-centered mt-6 pt-6 ml-0 mr-0\">\r\n            <div className=\"column is-full\">\r\n                {\r\n                    this.props.isLoading ?\r\n                    <div className=\"columns\">\r\n                        <div className=\"column has-text-centered\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                    </div> :\r\n                    <Review \r\n                        id={review.id}\r\n                        text={review.text}\r\n                        rating={review.rating}\r\n                        difficulty={review.difficulty}\r\n                        date={review.date}\r\n                        user={review.user}\r\n                        user_name={review.user_name}\r\n                        entity={review.entity}\r\n                        entity_name={review.entity_name}\r\n                        entity_type={review.entity_type}\r\n                        recomendations_count={review.recomendations_count}\r\n                        recomendations={review.recomendations}\r\n                        favorite={review.favorite}\r\n                    />\r\n                }\r\n            </div>\r\n        </div>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    review: state.reviews.review,\r\n    isLoading: state.reviews.isLoading,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(\r\n    mapStateToProps, \r\n    {getReview, clearReview}\r\n)(Embed);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewDetail.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MenuMobile.js",["334"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {GiHamburgerMenu} from 'react-icons/gi'\r\nimport {VscHome} from 'react-icons/vsc'\r\nimport {BsPersonLinesFill, BsBuilding} from 'react-icons/bs'\r\nimport {BiNews} from 'react-icons/bi'\r\nimport {MdLibraryBooks} from 'react-icons/md' \r\n\r\nexport class MenuMobile extends Component {\r\n\r\n    state = {\r\n        section: null\r\n    }\r\n\r\n    componentDidMount(){\r\n        const path = this.props.location.pathname.split(\"/\")\r\n        this.setState({ \r\n            section: path[path.length-1] \r\n        })\r\n    }\r\n\r\n    componentDidUpdate(prevPros){\r\n        if(prevPros.location.pathname !== this.props.location.pathname){\r\n            const path = this.props.location.pathname.split(\"/\")\r\n            this.setState({ \r\n                section: path[path.length-1] \r\n            })\r\n        }\r\n    }\r\n\r\n    render () {\r\n        return (\r\n            <nav className=\"navbar is-fixed-bottom columns is-mobile menu-mobile has-text-centered\">\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/'\r\n                        className={this.state.section === \"\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <VscHome size={24}/>\r\n                        </div>\r\n                    </Link> \r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/feed'\r\n                        className={this.state.section === \"feed\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <BiNews size={24} />\r\n                        </div>\r\n                    </Link>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/biblioteca'\r\n                        className={this.state.section === \"favoritas\" || this.state.section === \"recomendadas\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <MdLibraryBooks size={24} />\r\n                        </div>\r\n                    </Link>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to=\"/instituciones\"\r\n                        className={this.state.section === \"instituciones\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <BsBuilding size={24} />\r\n                        </div>\r\n                    </Link>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/profesores'\r\n                        className={this.state.section === \"profesores\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <BsPersonLinesFill size={24} />\r\n                        </div>\r\n                    </Link> \r\n                </div>\r\n            </nav>     \r\n        );\r\n    }\r\n}",{"ruleId":"335","replacedBy":"336"},{"ruleId":"337","replacedBy":"338"},{"ruleId":"339","severity":1,"message":"340","line":12,"column":10,"nodeType":"341","messageId":"342","endLine":12,"endColumn":16},{"ruleId":"339","severity":1,"message":"343","line":20,"column":7,"nodeType":"341","messageId":"342","endLine":20,"endColumn":11},{"ruleId":"339","severity":1,"message":"343","line":18,"column":13,"nodeType":"341","messageId":"342","endLine":18,"endColumn":17},{"ruleId":"339","severity":1,"message":"344","line":6,"column":10,"nodeType":"341","messageId":"342","endLine":6,"endColumn":16},{"ruleId":"339","severity":1,"message":"345","line":18,"column":16,"nodeType":"341","messageId":"342","endLine":18,"endColumn":18},{"ruleId":"339","severity":1,"message":"346","line":4,"column":8,"nodeType":"341","messageId":"342","endLine":4,"endColumn":17},{"ruleId":"339","severity":1,"message":"347","line":5,"column":5,"nodeType":"341","messageId":"342","endLine":5,"endColumn":26},{"ruleId":"339","severity":1,"message":"348","line":6,"column":5,"nodeType":"341","messageId":"342","endLine":6,"endColumn":25},{"ruleId":"339","severity":1,"message":"345","line":27,"column":16,"nodeType":"341","messageId":"342","endLine":27,"endColumn":18},{"ruleId":"339","severity":1,"message":"349","line":27,"column":36,"nodeType":"341","messageId":"342","endLine":27,"endColumn":40},{"ruleId":"339","severity":1,"message":"350","line":2,"column":22,"nodeType":"341","messageId":"342","endLine":2,"endColumn":29},{"ruleId":"339","severity":1,"message":"351","line":2,"column":9,"nodeType":"341","messageId":"342","endLine":2,"endColumn":13},{"ruleId":"339","severity":1,"message":"351","line":3,"column":19,"nodeType":"341","messageId":"342","endLine":3,"endColumn":23},{"ruleId":"339","severity":1,"message":"352","line":43,"column":16,"nodeType":"341","messageId":"342","endLine":43,"endColumn":21},{"ruleId":"339","severity":1,"message":"353","line":3,"column":8,"nodeType":"341","messageId":"342","endLine":3,"endColumn":18},{"ruleId":"339","severity":1,"message":"354","line":3,"column":9,"nodeType":"341","messageId":"342","endLine":3,"endColumn":24},"no-native-reassign",["355"],"no-negated-in-lhs",["356"],"no-unused-vars","'string' is defined but never used.","Identifier","unusedVar","'user' is assigned a value but never used.","'Review' is defined but never used.","'id' is assigned a value but never used.","'PropTypes' is defined but never used.","'REVIEW_BY_USER_LOADED' is defined but never used.","'CLEAR_REVIEW_BY_USER' is defined but never used.","'date' is assigned a value but never used.","'getUser' is defined but never used.","'Link' is defined but never used.","'email' is assigned a value but never used.","'RightPanel' is defined but never used.","'GiHamburgerMenu' is defined but never used.","no-global-assign","no-unsafe-negation"]