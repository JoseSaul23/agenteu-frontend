\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Review.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewInResults.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\School.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\University.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\UniversityDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\NotificationsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\CreateReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\LastAdded.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\Professor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsInMenuList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorDetails.js",["180"],"import React, {Component} from 'react'\r\nimport {useParams} from 'react-router-dom'\r\nimport {IoIosNotifications} from 'react-icons/io'\r\n\r\n// export function ProfessorDetails (){\r\n\r\n//     let { id } = useParams();\r\n\r\n//     return (\r\n//       <div>\r\n//         <h3>{id}</h3>\r\n//       </div>\r\n//     );\r\n//}\r\nexport class ProfessorDetails extends Component {\r\n    state = {\r\n        professor: {},\r\n    }\r\n\r\n    _fetchProfessor= () => {\r\n        fetch(\"http://localhost:8000/api/profesores/\" + this.props.match.params.id)\r\n      .then(res => res.json())\r\n      .then(professor => {\r\n        this.setState({ professor })\r\n      }) \r\n    }\r\n\r\n    componentDidMount() {\r\n        this._fetchProfessor()\r\n    }\r\n    \r\n    componentDidUpdate (prevProps) {\r\n        if (prevProps.match.params.id !== this.props.match.params.id) { \r\n            this._fetchProfessor()\r\n        }\r\n    }\r\n\r\n    render () {\r\n        const {name, professor_school, professor_university, overall_difficulty, overall_rating, reviews_count, subscribers_count}\r\n        = this.state.professor\r\n\r\n        return (\r\n            <div className=\"columns is-multiline\">\r\n                <div className=\"column\">\r\n                    <p className=\"black-title has-text-weight-medium big-text\">{name}</p>\r\n                </div>\r\n                <div className=\"column is-full pb-0 pt-0 closer-letters has-text-weight-medium\">\r\n                    <p>{professor_school}</p>\r\n                    <p>de {professor_university}</p> \r\n                </div>\r\n                <div className=\"column\">\r\n                    <div className=\"columns is-vcentered is-mobile \">\r\n                        <div className=\"column has-text-weight-medium is-three-quarters\">\r\n                            {reviews_count} reseñas\r\n                        </div>\r\n                        <div className=\"column\">\r\n                            <IoIosNotifications  className=\"is-size-2\"></IoIosNotifications>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"columns is-vcentered is-mobile has-text-weight-medium\">\r\n                        <div className=\"column has-text-centered Top-review-numbers\">\r\n                            <p>calificación general</p>\r\n                            <p className=\"has-text-success is-size-4 pt-2\">\r\n                                {overall_rating? overall_rating : \"N/A\"}\r\n                            </p>\r\n                        </div>\r\n                        <div className=\"column has-text-centered Top-review-numbers\">\r\n                            <p>dificultad promedio</p>\r\n                            <p className=\"has-text-danger is-size-4 pt-2\">\r\n                                {overall_difficulty? overall_difficulty + \"%\": \"N/A\"}\r\n                            </p>\r\n                        </div>\r\n                        <div className=\"column\">\r\n                            <button className=\"button is-small is-link\">\r\n                                <span className=\"medium-text has-text-weight-medium\">Crear reseña</span>\r\n                            </button> \r\n                        </div>\r\n                    </div>\r\n                    <div className=\"pb-3 has-text-weight-medium mt-2 mb-2\">\r\n                        <span className=\"black-title\">{subscribers_count}</span> usuarios esperan nueva reseña\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Logo.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\HeaderLinks.js",["181"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {IoIosNotifications} from 'react-icons/io'\r\n\r\nexport class HeaderLinks extends Component {\r\n    render () {\r\n        return (\r\n        <ul className=\"has-text-centered\">\r\n            <Link to=\"/registro\">\r\n                <li className=\"button is-warning small-text mr-5\">Registrarse</li>\r\n            </Link>\r\n            <Link to=\"/iniciar-sesion\">\r\n                <li className=\"button is-link small-text\">Iniciar sesión</li>\r\n            </Link>\r\n            {/* <li className=\"button small-text mr-5\"><IoIosNotifications  className=\"is-size-4\"></IoIosNotifications></li>\r\n            <li className=\"button is-link small-text\">Username ⯆</li> */}\r\n        </ul>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\SearchBox.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Header.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Home.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Menu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\SearchResults.js",["182","183"],"import React, {Component} from 'react'\r\nimport {University} from '../university/University'\r\nimport {Professor} from '../professor/Professor'\r\nimport {School} from '../school/School'\r\nimport {ReviewInResults} from '../review/ReviewInResults'\r\n\r\nexport class SearchResults extends Component {\r\n\r\n    render() {\r\n        return (\r\n            <div>\r\n                <div className=\"columns is-multiline m-2 pl-4\">\r\n                    {/* {this._renderResults()} */}\r\n                    {/* <University />  */}\r\n                        <School />\r\n                   \r\n                    {/* <div className=\"column is-one-quarter\">\r\n                        <Professor />\r\n                        <Professor />\r\n                        <Professor />\r\n                    </div> */}\r\n                </div>\r\n                <hr className=\"has-background-dark\"/>\r\n                <div className=\"m-3 ml-5\">\r\n                    <h5 className=\"title is-5\">Ultimas reseñas sobre Amaranta Jose Galileo Gutierrez</h5>\r\n                </div>\r\n                <div className=\"columns is-multiline m-2 mt-5 pl-4\">\r\n                    {/* {this._renderSingleResultReviews()} */} \r\n                    <ReviewInResults />\r\n                    <div className=\"column is-four-fifths p-0\"></div>\r\n                    <ReviewInResults />\r\n                    <div className=\"column is-four-fifths p-0\"></div>\r\n                    <ReviewInResults />\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RedirectAs404.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Profile.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RightPanel.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\ProfileNavBar.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MasterWrapper.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorInSideList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsInSideList.js",[],{"ruleId":"184","replacedBy":"185"},{"ruleId":"186","replacedBy":"187"},{"ruleId":"188","severity":1,"message":"189","line":2,"column":9,"nodeType":"190","messageId":"191","endLine":2,"endColumn":18},{"ruleId":"188","severity":1,"message":"192","line":3,"column":9,"nodeType":"190","messageId":"191","endLine":3,"endColumn":27},{"ruleId":"188","severity":1,"message":"193","line":2,"column":9,"nodeType":"190","messageId":"191","endLine":2,"endColumn":19},{"ruleId":"188","severity":1,"message":"194","line":3,"column":9,"nodeType":"190","messageId":"191","endLine":3,"endColumn":18},"no-native-reassign",["195"],"no-negated-in-lhs",["196"],"no-unused-vars","'useParams' is defined but never used.","Identifier","unusedVar","'IoIosNotifications' is defined but n