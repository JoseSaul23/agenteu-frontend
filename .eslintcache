port {AiOutlineLike} from 'react-icons/ai'\r\n\r\nexport class TopReview extends Component {\r\n    render () {\r\n      const {text, rating, difficulty, date, user, user_name, entity, entity_name, recomendations_count} = this.props\r\n      \r\n      return (\r\n        <div className=\"column is-one-quarter mb-5\">\r\n          <div className=\"Top-review-box\">\r\n            <div className=\"Top-review-text has-text-weight-medium\">\r\n              <p>{text}</p>\r\n            </div>\r\n            <div className=\"Top-review-numbers columns is-mobile\"> \r\n              <div className=\"column has-text-centered pb-1\">\r\n                <span className=\"review-numbers-label\">calificación</span> <span className=\"review-numbers-value\">{rating}</span>\r\n              </div>\r\n              <div className=\"column has-text-centered pb-1\">\r\n                <span className=\"review-numbers-label\">dificultad</span> <span className=\"review-numbers-value\">{difficulty}%</span>\r\n              </div>\r\n              <div className=\"column is-one-third p-0\">\r\n                <div className=\"mt-5 ml-4\">\r\n                  <AiOutlineLike className=\"is-size-5\"></AiOutlineLike> <span className=\"has-text-weight-semibold\">{recomendations_count}</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"Top-review-especifics has-text-weight-medium\">\r\n            <p>Por {user_name} - {date}</p>\r\n            <p>sobre {entity_name}</p>\r\n          </div>\r\n        </div>\r\n      );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Review.js",["184","185"],"import React, {Component} from 'react'\r\nimport {AiOutlineLike} from 'react-icons/ai'\r\nimport {BsBookmark, BsFlagFill} from 'react-icons/bs'\r\nimport {RiShareForwardFill} from 'react-icons/ri'\r\n\r\nexport class Review extends Component {\r\n    render () {\r\n        const {text, rating, difficulty, date, user, user_name, entity, entity_name, recomendations_count} = this.props\r\n\r\n        return (\r\n            <div className=\"columns is-multiline mb-5\">\r\n                <div className=\"column is-full has-text-weight-medium small-label p-0 pl-1 closer-letters\">\r\n                    <p>\r\n                        <span className=\"black-title\">{user_name}</span> - {date}\r\n                    </p>\r\n                    <p>\r\n                        sobre {entity_name}\r\n                    </p>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <div className=\"columns is-mobile\">\r\n                        <div className=\"column is-four-fifths review-main-box pt-2 pr-2 pl-2 pb-0\"> \r\n                            <div className=\"review-text\"> \r\n                                <p>\r\n                                    {text}\r\n                                </p>\r\n                            </div>\r\n                            <div className=\"columns is-mobile pt-2\"> \r\n                                <div className=\"column is-8-desktop is-half-mobile icon\">\r\n                                    <AiOutlineLike className=\"is-size-5\" />\r\n                                    {recomendations_count}    \r\n                                </div>\r\n                                <div className=\"column has-text-centered\">\r\n                                    <BsBookmark className=\"is-size-5\" />  \r\n                                </div>\r\n                                <div className=\"column has-text-centered\">\r\n                                    <RiShareForwardFill className=\"is-size-5\" />\r\n                                </div >\r\n                                <div className=\"column has-text-centered\">\r\n                                    <BsFlagFill  className=\"is-size-5\" />\r\n                                </div >\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"column has-text-centered has-text-weight-medium pt-0\"> \r\n                            <div className=\"review-main-box mb-4 close-letters\"> \r\n                                <p>calificación</p>\r\n                                <p className=\"is-size-4\">{rating}</p> \r\n                            </div>\r\n                            <div className=\"review-main-box close-letters\"> \r\n                                <p>dificultad</p>\r\n                                <p className=\"is-size-4\">{difficulty}%</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewInResults.js",["186","187","188"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\School.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\University.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\UniversityDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\NotificationsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Create