 list-border-bottom\">\r\n                <div className=\"column is-6\">\r\n                    <div className=\"columns is-multiline\">\r\n                        <div className=\"column is-full big-text black-title has-text-weight-medium\">\r\n                            {name}\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"column\"> \r\n                    <IoIosNotifications className=\"custom-icon is-size-3\"/>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\SubscriptionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\subscriptionsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\subscriptionsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPassword.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPasswordConfirmation.js",["337","338"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Embed.js",["339"],{"ruleId":"340","replacedBy":"341"},{"ruleId":"342","replacedBy":"343"},{"ruleId":"344","severity":1,"message":"345","line":12,"column":10,"nodeType":"346","messageId":"347","endLine":12,"endColumn":16},{"ruleId":"344","severity":1,"message":"348","line":20,"column":7,"nodeType":"346","messageId":"347","endLine":20,"endColumn":11},{"ruleId":"344","severity":1,"message":"348","line":18,"column":13,"nodeType":"346","messageId":"347","endLine":18,"endColumn":17},{"ruleId":"344","severity":1,"message":"349","line":6,"column":10,"nodeType":"346","messageId":"347","endLine":6,"endColumn":16},{"ruleId":"344","severity":1,"message":"350","line":18,"column":16,"nodeType":"346","messageId":"347","endLine":18,"endColumn":18},{"ruleId":"344","severity":1,"message":"351","line":4,"column":8,"nodeTy