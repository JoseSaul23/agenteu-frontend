\n            <div className=\"column has-text-centered pb-1\">\r\n              <p className=\"review-numbers-label\">calificación</p>\r\n              <p\r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(rating, \"rating\")}}\r\n              > \r\n                {rating}\r\n              </p>\r\n            </div>\r\n            <div className=\"column has-text-centered pb-1\">\r\n              <p className=\"review-numbers-label\">dificultad</p>\r\n              <p \r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(difficulty, \"difficulty\")}}\r\n              >\r\n                {difficulty}%\r\n              </p>\r\n            </div>\r\n            <div className=\"column is-one-third p-0\">\r\n              <div className=\"mt-5 ml-4\">\r\n                <AiOutlineLike className=\"is-size-5\"></AiOutlineLike> <span className=\"has-text-weight-semibold\">{recomendations_count}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"Top-review-especifics has-text-weight-medium\">\r\n          <p>Por {user_name} - {date}</p>\r\n          <Link to={\r\n                entity_type === \"Professor\"\r\n                ? \"/profesores/\" + entity\r\n                : entity_type === \"School\"\r\n                ? \"/escuelas/\" + entity\r\n                : \"/universidades/\" + entity\r\n              }>\r\n            <p>sobre {entity_name}</p>\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Review.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewInResults.js",["272"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class ReviewInResults extends Component {\r\n    render () {\r\n        const {text, rating, difficulty, date, user, user_name, entity, entity_type, entity_name} = this.props\r\n\r\n        return (\r\n            <div className=\"column is-three-fifths mb-5\">\r\n                <div className=\"columns is-7\">\r\n                    <div className=\"column is-two-fifths Top-review-box p-2\">\r\n                        <div className=\"Results-review-text has-text-weight-medium\">\r\n                            {/* regresar short-text de API */}\r\n                            <p>{text}</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"column pr-4 pl-4 pt-0\"> \r\n                        <div className=\"pb-3\">\r\n                            <p className=\"has-text-weight-medium\">Por {user_name} - {date}</p>\r\n                            <Link to={\r\n                                    entity_type === \"Professor\"\r\n                                    ? \"/profesores/\" + entity\r\n                                    : entity_type === \"School\"\r\n                                    ? \"/escuelas/\" + entity\r\n                                    : \"/universidades/\" + entity\r\n                                }>\r\n                                <p className=\"institution-labels\">sobre {entity_name}</p>\r\n                            </Link>\r\n                        </div>\r\n                        <div className=\"columns is-mobile\">\r\n                            <div className=\"column has-text-centered is-one-quarter\">\r\n                                <p className=\"institution-labels\">calificación</p>\r\n                                <p \r\n                                    className=\"has-text-weight-medium\"\r\n                                    style={ {color: _myColor(rating, \"rating\")} }\r\n                                >\r\n                                    {rating}\r\n                                </p>\r\n                            </div>\r\n                            <div className=\"column has-text-centered is-one-quarter\">\r\n                                <p className=\"institution-labels\">dificultad</p>\r\n                                <p \r\n                                    className=\"has-text-weight-medium\"\r\n                                    style={ {color: _myColor(difficulty, \"difficulty\")} }\r\n                                >\r\n                                    {difficulty}%\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\School.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\University.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\UniversityDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\NotificationsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\CreateReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\LastAdded.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\Professor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsInMenuList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Logo.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\HeaderLinks.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\SearchBox.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Header.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Home.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Menu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\SearchResults.js",["273"],"import React, {Component} from 'react'\r\nimport {University} from '../university/University'\r\nimport {Professor} from '../professor/Professor'\r\nimport {School} from '../school/School'\r\nimport {ReviewInResults} from '../review/ReviewInResults'\r\nimport { Review } from '../review/Review'\r\n\r\nexport class SearchResults extends Component {\r\n\r\n    state = {\r\n        results: [],\r\n        first_result_name: \"\",\r\n        first_result_reviews: []\r\n    }\r\n\r\n    _fetchResults = () => {\r\n        const {entity, q} = this.props.match.params\r\n\r\n        fetch(`http://localhost:8000/api/${entity}/?search=` + q)\r\n        .then(res => res.json())\r\n        .then(results => {\r\n            this.setState({results})\r\n            if (results[0] !== undefined){\r\n                this.setState( {\r\n                    first_result_name: results[0].name\r\n                })\r\n                this._fetchFirstResultReviews(results[0].id)\r\n            }\r\n        }) \r\n    }\r\n\r\n    componentDidMount() {\r\n        this._fetchResults()\r\n    }\r\n\r\n    componentDidUpdate (prevProps) {\r\n        const {entity, q} = this.props.match.params\r\n        if (prevProps.match.params.q !== q || prevProps.match.params.entity !== entity ) { \r\n            this._fetchResults()\r\n        }\r\n    }\r\n\r\n    _renderProfessorsResults() {\r\n        const {results} = this.state\r\n        if (results.length === 0) {\r\n            return (\r\n                <div>No se encontraron resultados para su búsqueda.</div>\r\n            );\r\n        }\r\n        else {\r\n            return results.map( result => {\r\n                return (\r\n                    <Professor \r\n                        key={result.id} \r\n                        id={result.id}\r\n                        name={result.name}\r\n                        professor_university={result.professor_university}\r\n                        professor_school={result.professor_school}\r\n                        professor_school_name={result.professor_school_name}\r\n                        professor_university_name={result.professor_university_name}\r\n                        overall_difficulty={result.overall_difficulty}\r\n                        overall_rating={result.overall_rating}\r\n                        reviews_count={result.reviews_count}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    _renderUniversitiesResults() {\r\n        const {results} = this.state\r\n        if (results.length === 0) {\r\n            return (\r\n                <div>No se encontraron resultados para su búsqueda.</div>\r\n            );\r\n        }\r\n        else {\r\n            return results.map( result => {\r\n                return (\r\n                    <University \r\n                    key={result.id}\r\n                    id={result.id}\r\n                    name={result.name}\r\n                    logo={result.logo}\r\n                    reviews_count={result.reviews_count}\r\n                    overall_rating={result.overall_rating}\r\n                    overall_difficulty={result.overall_difficulty}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    _renderSchoolsResults() {\r\n        const {results} = this.state\r\n        if (results.length === 0) {\r\n            return (\r\n                <div>No se encontraron resultados para su búsqueda.</div>\r\n            );\r\n        }\r\n        else {\r\n            return results.map( result => {\r\n                return (\r\n                    <School \r\n                    key={result.id}\r\n                    id={result.id}\r\n                    name={result.name}\r\n                    school_logo={result.logo}\r\n                    school_university={result.school_university}\r\n                    school_university_name={result.school_university_name}\r\n                    reviews_count={result.reviews_count}\r\n                    overall_rating={result.overall_rating}\r\n                    overall_difficulty={result.overall_difficulty}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    _fetchFirstResultReviews = (id) => {\r\n        const {entity} = this.props.match.params\r\n\r\n        fetch(`http://localhost:8000/api/${entity}/${id}/reviews`)\r\n        .then(res => res.json())\r\n        .then(first_result_reviews => {\r\n            this.setState({first_result_reviews})\r\n        }) \r\n    }\r\n\r\n    _renderFirstResultReviews = () => {\r\n        const {first_result_reviews} = this.state\r\n        if (first_result_reviews.length === 0) {\r\n            return (\r\n                <div>Sin reseñas</div>\r\n            );\r\n        }\r\n        else {\r\n            return first_result_reviews.map( review => {\r\n                return (\r\n                    <ReviewInResults \r\n                        key={review.id}\r\n                        id={review.id}\r\n                        text={review.text}\r\n                        rating={review.rating}\r\n                        difficulty={review.difficulty}\r\n                        date={review.date}\r\n                        user_name={review.user_name}\r\n                        entity={review.entity}\r\n                        entity_name={review.entity_name}\r\n                        entity_type={review.entity_type}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    render() {\r\n        const {entity} = this.props.match.params\r\n        const {results, first_result_name} = this.state\r\n\r\n        return (\r\n            <div>\r\n                <div className=\"columns is-multiline m-2 pl-4\">\r\n                    { \r\n                        entity === \"profesores\"\r\n                        ? \r\n                            <div className=\"column is-one-quarter\">\r\n                                {this._renderProfessorsResults()}\r\n                            </div>\r\n                        :   \r\n                            entity === \"universidades\"\r\n                            ?\r\n                                this._renderUniversitiesResults()\r\n                            :\r\n                                entity === \"escuelas\"\r\n                                ?\r\n                                    this._renderSchoolsResults()\r\n                                :\r\n                                    <div>Eliga una categoria de búsqueda</div>\r\n                    }\r\n                </div>\r\n                {results.length !== 0\r\n                ?   <React.Fragment>\r\n                        <hr className=\"horizontal-line\"/>\r\n                        <div className=\"m-3 ml-5\">\r\n                            <h5 className=\"title is-5\">Ultimas reseñas sobre {first_result_name}</h5>\r\n                        </div>\r\n                        <div className=\"columns is-multiline m-2 mt-5 pl-4\">\r\n                            {this._renderFirstResultReviews()} \r\n                        </div>\r\n                    </React.Fragment>\r\n                :\r\n                    <React.Fragment />\r\n                }\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RedirectAs404.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Profile.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RightPanel.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\ProfileNavBar.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MasterWrapper.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorInSideList.js",[],["274","275"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsInSideList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\store.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\util.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\index.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\authReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\errorReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\types.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\authActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\errorActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\PrivateRoute.js",["276"],"import React from 'react'\r\nimport {Route, Redirect} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\n\r\nconst PrivateRoute = ({ component: Component, auth, ...rest}) =>(\r\n        <Route \r\n        {...rest}\r\n        render= {(props) => {\r\n            if (auth.isLoading) {\r\n                return <div>Cargando...</div>\r\n            }\r\n            else if (!auth.isAuthenticated) {\r\n                return <Redirect to=\"/iniciar-sesion\"/>\r\n            }\r\n            else {\r\n                return <Component {...props}/>\r\n            }\r\n        }}\r\n        />\r\n);\r\n\r\n\r\nconst mapStateToProps = (state) => ({\r\n    auth: state.auth\r\n})\r\n\r\nexport default connect(mapStateToProps)(PrivateRoute)","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\reviewReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\reviewActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityDetailsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityDetailsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\EditReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserListReviews.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\notificationReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\Notification.js",["277","278"],"import React, {Component} from 'react'\r\nimport {FaTrashAlt} from 'react-icons/fa'\r\nimport {AiOutlineCheck} from 'react-icons/ai'\r\nimport {GoPrimitiveDot} from 'react-icons/go'\r\nimport {MdKeyboardArrowRight} from 'react-icons/md'\r\nimport {connect} from 'react-redux'\r\nimport {checkNotification, deleteNotification} from '../actions/notificationsActions'\r\nimport PropTypes from 'prop-types'\r\n\r\nexport class Notification extends Component {\r\n\r\n    static propTypes = {\r\n        deleteNotification: PropTypes.func.isRequired,\r\n        checkNotification: PropTypes.func.isRequired,\r\n    }\r\n\r\n    _handleDelete = () => {\r\n        this.props.deleteNotification(this.props.id)\r\n    }\r\n\r\n    _handleCheck = () => {\r\n        this.props.checkNotification(this.props.id)\r\n    }\r\n\r\n    render() {\r\n\r\n        const {id, message, check, date} = this.props\r\n\r\n        return (\r\n            <div className=\"pt-2 pb-2 pl-4 pr-4 list-border-bottom\">\r\n                <div className=\"columns\">\r\n                    <div className=\"column is-10\">\r\n                        {   \r\n                            !check ?\r\n                            <GoPrimitiveDot className=\"has-text-link\"/> :\r\n                            \"\"\r\n                        }\r\n                        {message} \r\n                    </div>\r\n                    <div className=\"column\">\r\n                        <span className=\"has-text-warning-dark\">\r\n                            {\r\n                                !check ?\r\n                                <AiOutlineCheck\r\n                                onClick={this._handleCheck}\r\n                                className=\"custom-icon is-size-6\" \r\n                                /> :\r\n                                <MdKeyboardArrowRight\r\n                                onClick={this._handleCheck}\r\n                                className=\"custom-icon is-size-6\" \r\n                            />\r\n                            }\r\n                        </span>\r\n                    </div>\r\n                    <div className=\"column\">\r\n                        <span className=\"has-text-danger-dark\">\r\n                            <FaTrashAlt \r\n                                onClick={this._handleDelete}\r\n                                className=\"custom-icon is-size-6\" \r\n                            />\r\n                        </span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}\r\n\r\n\r\nexport default connect(null, {checkNotification, deleteNotification})(Notification);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\notificationsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\userFeedReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\userFeedActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityActions.js",[],{"ruleId":"279","replacedBy":"280"},{"ruleId":"281","replacedBy":"282"},{"ruleId":"283","severity":1,"message":"284","line":14,"column":7,"nodeType":"285","messageId":"286","endLine":14,"endColumn":11},{"ruleId":"283","severity":1,"message":"284","line":7,"column":48,"nodeType":"285","messageId":"286","endLine":7,"endColumn":52},{"ruleId":"283","severity":1,"message":"287","line":6,"column":10,"nodeType":"285","messageId":"286","endLine":6,"endColumn":16},{"ruleId":"279","replacedBy":"288"},{"ruleId":"281","replacedBy":"289"},{"ruleId":"283","severity":1,"message":"290","line":4,"column":8,"nodeType":"285","messageId":"286","endLine":4,"endColumn":17},{"ruleId":"283","severity":1,"message":"291","line":27,"column":16,"nodeType":"285","messageId":"286","endLine":27,"endColumn":18},{"ruleId":"283","severity":1,"message":"292","line":27,"column":36,"nodeType":"285","messageId":"286","endLine":27,"endColumn":40},"no-native-reassign",["293"],"no-negated-in-lhs",["294"],"no-unused-vars","'user' is assigned a value but never used.","Identifier","unusedVar","'Review' is defined but never used.",["293"],["294"],"'PropTypes' 