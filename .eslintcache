         <div className=\"column is-two-thirds pr-0 mt-4\">\r\n                    <div className=\"columns is-multiline is-centered pl-4\">\r\n                        <div className=\"column is-four-fifths mb-2\">\r\n                            <h5 className=\"title is-5\">Mis reseñas</h5>\r\n                        </div>\r\n                        <div className=\"column is-four-fifths mt-2\">\r\n                            {/* <ReviewsList entity=\"user-reviews\"/> */}\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <RightPanel />\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserAccount.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserLibrary.js",["239"],"import React, {Component} from 'react'\r\nimport {ReviewsList} from '../review/ReviewsList'\r\nimport {ProfileNavBar} from '../common/ProfileNavBar'\r\nimport {MdLibraryBooks} from 'react-icons/md' \r\nimport {RightPanel} from '../common/RightPanel'\r\nimport {Link} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\n\r\nexport class UserLibrary extends Component {\r\n\r\n    static propTypes = {\r\n        isAuthenticated: PropTypes.bool\r\n    }\r\n\r\n    render () {\r\n\r\n        if (!this.props.isAuthenticated) {\r\n            return (\r\n                <div className=\"columns pt-6\">\r\n                    <div className=\"column is-half is-offset-one-quarter has-text-centered pt-6\">\r\n                        <div className=\"m-5\">\r\n                            <MdLibraryBooks className=\"is-size-1\" />\r\n                        </div>\r\n                        <div className=\"m-5\">\r\n                            <h4 className=\"title is-4\">Guarda tus reseñas favoritas</h4>\r\n                        </div>\r\n                        <div className=\"m-5\">\r\n                            <p>\r\n                                Inicia sesión para encontrar las reseñas que guardes o que recomiendes \r\n                            </p>\r\n                        </div>\r\n                        <div className=\"m-5\">\r\n                            <Link to=\"/iniciar-sesion\">\r\n                                <button className=\"button is-link\">Iniciar sesión</button>\r\n                            </Link>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            );\r\n        }\r\n\r\n        return (\r\n            <div className=\"columns\">\r\n                <div className=\"column is-two-thirds pr-0\">\r\n                    <div className=\"columns is-multiline is-centered pl-4\">\r\n                        <div className=\"column mb-3\">\r\n                            <ProfileNavBar subject=\"library\"/>\r\n                        </div>\r\n                        <div className=\"column is-four-fifths mt-2\">\r\n                            {/* <ReviewsList /> */}\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <RightPanel />\r\n            </div>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    isAuthenticated : state.auth.isAuthenticated,\r\n});\r\n\r\nexport default connect(mapStateToProps)(UserLibrary);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserFeed.js",["240"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\Login.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\Register.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReview.js",["241"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {AiOutlineLike} from 'react-icons/ai'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class TopReview extends Component {\r\n\r\n  render () {\r\n    const {\r\n      text,\r\n      rating,\r\n      difficulty,\r\n      date,\r\n      user,\r\n      user_name,\r\n      entity,\r\n      entity_name,\r\n      entity_type,\r\n      recomendations_count\r\n    } = this.props\r\n    \r\n    return (\r\n      <div className=\"column is-one-quarter mb-5\">\r\n        <div className=\"Top-review-box\">\r\n          <div className=\"Top-review-text has-text-weight-medium\">\r\n            <p>{text}</p>\r\n          </div>\r\n          <div className=\"Top-review-numbers columns is-mobile\"> \r\n            <div className=\"column has-text-centered pb-1\">\r\n              <p className=\"review-numbers-label\">calificación</p>\r\n              <p\r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(rating, \"rating\")}}\r\n              > \r\n                {rating}\r\n              </p>\r\n            </div>\r\n            <div className=\"column has-text-centered pb-1\">\r\n              <p className=\"review-numbers-label\">dificultad</p>\r\n              <p \r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(difficulty, \"difficulty\")}}\r\n              >\r\n                {difficulty}%\r\n              </p>\r\n            </div>\r\n            <div className=\"column is-one-third p-0\">\r\n              <div className=\"mt-5 ml-4\">\r\n                <AiOutlineLike className=\"is-size-5\"></AiOutlineLike> <span className=\"has-text-weight-semibold\">{recomendations_count}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"Top-review-especifics has-text-weight-medium\">\r\n          <p>Por {user_name} - {date}</p>\r\n          <Link to={\r\n                entity_type === \"Professor\"\r\n                ? \"/profesores/\" + entity\r\n                : entity_type === \"School\"\r\n                ? \"/escuelas/\" + entity\r\n                : \"/universidades/\" + entity\r\n              }>\r\n            <p>sobre {entity_name}</p>\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Review.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewInResults.js",["242"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class ReviewInResults extends Component {\r\n    render () {\r\n        const {text, rating, difficulty, date, user, user_name, entity, entity_type, entity_name} = this.props\r\n\r\n        return (\r\n            <div className=\"column is-three-fifths mb-5\">\r\n                <div className=\"columns is-7\">\r\n                    <div className=\"column is-two-fifths Top-review-box p-2\">\r\n                        <div className=\"Results-review-text has-text-weight-medium\">\r\n                            {/* regresar short-text de API */}\r\n                            <p>{text}</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"column pr-4 pl-4 pt-0\"> \r\n                        <div className=\"pb-3\">\r\n                            <p className=\"has-text-weight-medium\">Por {user_name} - {date}</p>\r\n                            <Link to={\r\n                                    entity_type === \"Professor\"\r\n                                    ? \"/profesores/\" + entity\r\n                                    : entity_type === \"School\"\r\n                                    ? \"/escuelas/\" + entity\r\n                                    