:"164"},"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\index.js",["324","325","326"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\App.js",["327"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\reportWebVitals.js",[],["328","329"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserReviews.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserAccount.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserLibrary.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserFeed.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\Login.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\Register.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReview.js",["330"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {AiOutlineLike} from 'react-icons/ai'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class TopReview extends Component {\r\n\r\n  truncate(str) {\r\n    return str.length > 80 ? str.substring(0, 70) + \"...\" : str;\r\n  }\r\n\r\n  render () {\r\n\r\n    const {\r\n      id,\r\n      text,\r\n      rating,\r\n      difficulty,\r\n      date,\r\n      user,\r\n      user_name,\r\n      entity,\r\n      entity_name,\r\n      entity_type,\r\n      recomendations_count\r\n    } = this.props\r\n    \r\n    return (\r\n      <div className=\"column is-3-desktop is-4-tablet\">\r\n        <div className=\"Top-review-box\">\r\n          <Link to={\"/publicaciones/\" + id}>\r\n            <div className=\"Top-review-text has-text-weight-medium\">\r\n              <p>{this.truncate(text)}</p>\r\n            </div>\r\n          </Link>\r\n          <div className=\"Top-review-numbers columns is-mobile\"> \r\n            <div className=\"column has-text-centered pb-1\">\r\n              <p className=\"review-numbers-label\">calificación</p>\r\n              <p\r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(rating, \"rating\")}}\r\n              > \r\n                {rating}\r\n              </p>\r\n            </div>\r\n            <div className=\"column has-text-centered pb-1 px-0\">\r\n              <p className=\"review-numbers-label\">dificultad</p>\r\n              <p \r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(difficulty, \"difficulty\")}}\r\n              >\r\n                {difficulty}%\r\n              </p>\r\n            </div>\r\n            <div className=\"column p-0\">\r\n              <div className=\"mt-5 ml-4 centered-label\">\r\n                <AiOutlineLike className=\"is-size-5\"></AiOutlineLike>\r\n                <span className=\"has-text-weight-semibold\">{recomendations_count}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"Top-review-especifics has-text-weight-medium\">\r\n          <p>Por {user_name} - {date}</p>\r\n          <Link to={\r\n                entity_type === \"Professor\"\r\n                ? \"/profesores/\" + entity\r\n                : entity_type === \"School\"\r\n                ? \"/escuelas/\" + entity\r\n                : \"/universidades/\" + entity\r\n              }>\r\n            <p>sobre {entity_name}</p>\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Review.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewInResults.js",["331"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class ReviewInResults extends Component {\r\n\r\n    truncate(str) {\r\n        return str.length > 100 ? str.substring(0, 80) + \"...\" : str;\r\n    }\r\n\r\n    render () {\r\n        const {\r\n            id,\r\n            text,\r\n            rating,\r\n            difficulty,\r\n            date,\r\n            user,\r\n            user_name,\r\n            entity,\r\n            entity_type,\r\n            entity_name\r\n        } = this.props\r\n\r\n        return (\r\n            <div className=\"column is-three-fifths mb-5\">\r\n                <div className=\"columns is-7\">\r\n                    <div className=\"column is-two-fifths Top-review-box p-2\">\r\n                        <Link to={\"/publicaciones/\" + id}>\r\n                            <div className=\"Results-review-text has-text-weight-medium\">\r\n                                <p className=\"text-overflow\">{this.truncate(text)}</p>\r\n                            </div>\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"column pr-4 pl-4 pt-0\"> \r\n                        <div className=\"pb-3\">\r\n                            <p className=\"has-text-weight-medium\">Por {user_name} - {date}</p>\r\n                            <Link to={\r\n                                    entity_type === \"Professor\"\r\n                                    ? \"/profesores/\" + entity\r\n                                    : entity_type === \"School\"\r\n                                    ? \"/escuelas/\" + entity\r\n                                    : \"/universidades/\" + entity\r\n                                }>\r\n                                <p className=\"institution-labels\">sobre {entity_name}</p>\r\n                            </Link>\r\n                        </div>\r\n                        <div className=\"columns is-mobile\">\r\n                            <div className=\"column has-text-centered is-one-quarter\">\r\n                                <p className=\"institution-labels\">calificación</p>\r\n                                <p \r\n                                    className=\"has-text-weight-medium\"\r\n                                    style={ {color: _myColor(rating, \"rating\")} }\r\n                                >\r\n                                    {rating}\r\n                                </p>\r\n                            </div>\r\n                            <div className=\"column has-text-centered is-one-quarter\">\r\n                                <p className=\"institution-labels\">dificultad</p>\r\n                                <p \r\n                                    className=\"has-text-weight-medium\"\r\n                                    style={ {color: _myColor(difficulty, \"difficulty\")} }\r\n                                >\r\n                                    {difficulty}%\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\School.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\University.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\UniversityDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionsList.js",[],"C:\\Users\\Lenovo\\