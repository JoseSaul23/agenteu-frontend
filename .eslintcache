es":"321","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"322","messages":"323","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"324","usedDeprecatedRules":"160"},{"filePath":"325","messages":"326","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\index.js",[],["327","328"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\App.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\reportWebVitals.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserReviews.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserAccount.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserLibrary.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserFeed.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\Login.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\Register.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReview.js",["329"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {AiOutlineLike} from 'react-icons/ai'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class TopReview extends Component {\r\n\r\n  truncate(str) {\r\n    return str.length > 80 ? str.substring(0, 70) + \"...\" : str;\r\n  }\r\n\r\n  render () {\r\n\r\n    const {\r\n      id,\r\n      text,\r\n      rating,\r\n      difficulty,\r\n      date,\r\n      user,\r\n      user_name,\r\n      entity,\r\n      entity_name,\r\n      entity_type,\r\n      recomendations_count\r\n    } = this.props\r\n    \r\n    return (\r\n      <div className=\"column is-3-desktop is-4-tablet\">\r\n        <div className=\"Top-review-box\">\r\n          <Link to={\"/publicaciones/\" + id}>\r\n            <div className=\"Top-review-text has-text-weight-medium\">\r\n              <p>{this.truncate(text)}</p>\r\n            </div>\r\n          </Link>\r\n          <div className=\"Top-review-numbers columns is-mobile\"> \r\n            <div className=\"column has-text-centered pb-1\">\r\n              <p className=\"review-numbers-label\">calificación</p>\r\n              <p\r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(rating, \"rating\")}}\r\n              > \r\n                {rating}\r\n              </p>\r\n            </div>\r\n            <div className=\"column has-text-centered pb-1 px-0\">\r\n              <p className=\"review-numbers-label\">dificultad</p>\r\n              <p \r\n                className=\"review-numbers-value has-text-weight-medium\"\r\n                style={{color: _myColor(difficulty, \"difficulty\")}}\r\n              >\r\n                {difficulty}%\r\n              </p>\r\n            </div>\r\n            <div className=\"column p-0\">\r\n              <div className=\"mt-5 ml-4 centered-label\">\r\n                <AiOutlineLike className=\"is-size-5\"></AiOutlineLike>\r\n                <span className=\"has-text-weight-semibold\">{recomendations_count}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"Top-review-especifics has-text-weight-medium\">\r\n          <p>Por {user_name} - {date}</p>\r\n          <Link to={\r\n                entity_type === \"Professor\"\r\n                ? \"/profesores/\" + entity\r\n                : entity_type === \"School\"\r\n                ? \"/escuelas/\" + entity\r\n                : \"/universidades/\" + entity\r\n              }>\r\n            <p>sobre {entity_name}</p>\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\TopReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Review.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewInResults.js",["330"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {_myColor} from '../common/util'\r\n\r\nexport class ReviewInResults extends Component {\r\n\r\n    truncate(str) {\r\n        return str.length > 100 ? str.substring(0, 80) + \"...\" : str;\r\n    }\r\n\r\n    render () {\r\n        const {\r\n            id,\r\n            text,\r\n            rating,\r\n            difficulty,\r\n            date,\r\n            user,\r\n            user_name,\r\n            entity,\r\n            entity_type,\r\n            entity_name\r\n        } = this.props\r\n\r\n        return (\r\n            <div className=\"column is-three-fifths mb-5\">\r\n                <div className=\"columns is-7\">\r\n                    <div className=\"column is-two-fifths Top-review-box p-2\">\r\n                        <Link to={\"/publicaciones/\" + id}>\r\n                            <div className=\"Results-review-text has-text-weight-medium\">\r\n                                <p className=\"text-overflow\">{this.truncate(text)}</p>\r\n                            </div>\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"column pr-4 pl-4 pt-0\"> \r\n                        <div className=\"pb-3\">\r\n                            <p className=\"has-text-weight-medium\">Por {user_name} - {date}</p>\r\n                            <Link to={\r\n                                    entity_type === \"Professor\"\r\n                                    ? \"/profesores/\" + entity\r\n                                    : entity_type === \"School\"\r\n                                    ? \"/escuelas/\" + entity\r\n                                    : \"/universidades/\" + entity\r\n                                }>\r\n                                <p className=\"institution-labels\">sobre {entity_name}</p>\r\n                            </Link>\r\n                        </div>\r\n                        <div className=\"columns is-mobile\">\r\n                            <div className=\"column has-text-centered is-one-quarter\">\r\n                                <p className=\"institution-labels\">calificación</p>\r\n                                <p \r\n                                    className=\"has-text-weight-medium\"\r\n                                    style={ {color: _myColor(rating, \"rating\")} }\r\n                                >\r\n                                    {rating}\r\n                                </p>\r\n                            </div>\r\n                            <div className=\"column has-text-centered is-one-quarter\">\r\n                                <p className=\"institution-labels\">dificultad</p>\r\n                                <p \r\n                                    className=\"has-text-weight-medium\"\r\n                                    style={ {color: _myColor(difficulty, \"difficulty\")} }\r\n                                >\r\n                                    {difficulty}%\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\School.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SchoolDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\University.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\UniversityDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\InstitutionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\NotificationsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\CreateReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\LastAdded.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\Professor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorInMenu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorsInMenuList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\ProfessorDetails.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Logo.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\HeaderLinks.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\SearchBox.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Header.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Home.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Menu.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\SearchResults.js",["331"],"import React, {Component} from 'react'\r\nimport {University} from '../university/University'\r\nimport {Professor} from '../professor/Professor'\r\nimport {School} from '../school/School'\r\nimport {ReviewInResults} from '../review/ReviewInResults'\r\nimport { Review } from '../review/Review'\r\n\r\nexport class SearchResults extends Component {\r\n\r\n    state = {\r\n        results: [],\r\n        first_result_name: \"\",\r\n        first_result_reviews: []\r\n    }\r\n\r\n    _fetchResults = () => {\r\n        const {entity, q} = this.props.match.params\r\n\r\n        fetch(`http://localhost:8000/api/${entity}/?search=` + q)\r\n        .then(res => res.json())\r\n        .then(results => {\r\n            this.setState({results})\r\n            if (results[0] !== undefined){\r\n                this.setState( {\r\n                    first_result_name: results[0].name\r\n                })\r\n                this._fetchFirstResultReviews(results[0].id)\r\n            }\r\n        }) \r\n    }\r\n\r\n    componentDidMount() {\r\n        this._fetchResults()\r\n    }\r\n\r\n    componentDidUpdate (prevProps) {\r\n        const {entity, q} = this.props.match.params\r\n        if (prevProps.match.params.q !== q || prevProps.match.params.entity !== entity ) { \r\n            this._fetchResults()\r\n        }\r\n    }\r\n\r\n    _renderProfessorsResults() {\r\n        const {results} = this.state\r\n        if (results.length === 0) {\r\n            return (\r\n                <div>No se encontraron resultados para su búsqueda.</div>\r\n            );\r\n        }\r\n        else {\r\n            return results.map( result => {\r\n                return (\r\n                    <Professor \r\n                        key={result.id} \r\n                        id={result.id}\r\n                        name={result.name}\r\n                        professor_university={result.professor_university}\r\n                        professor_school={result.professor_school}\r\n                        professor_school_name={result.professor_school_name}\r\n                        professor_university_name={result.professor_university_name}\r\n                        overall_difficulty={result.overall_difficulty}\r\n                        overall_rating={result.overall_rating}\r\n                        reviews_count={result.reviews_count}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    _renderUniversitiesResults() {\r\n        const {results} = this.state\r\n        if (results.length === 0) {\r\n            return (\r\n                <div>No se encontraron resultados para su búsqueda.</div>\r\n            );\r\n        }\r\n        else {\r\n            return results.map( result => {\r\n                return (\r\n                    <University \r\n                    key={result.id}\r\n                    id={result.id}\r\n                    name={result.name}\r\n                    logo={result.logo}\r\n                    reviews_count={result.reviews_count}\r\n                    overall_rating={result.overall_rating}\r\n                    overall_difficulty={result.overall_difficulty}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    _renderSchoolsResults() {\r\n        const {results} = this.state\r\n        if (results.length === 0) {\r\n            return (\r\n                <div>No se encontraron resultados para su búsqueda.</div>\r\n            );\r\n        }\r\n        else {\r\n            return results.map( result => {\r\n                return (\r\n                    <School \r\n                    key={result.id}\r\n                    id={result.id}\r\n                    name={result.name}\r\n                    school_logo={result.logo}\r\n                    school_university={result.school_university}\r\n                    school_university_name={result.school_university_name}\r\n                    reviews_count={result.reviews_count}\r\n                    overall_rating={result.overall_rating}\r\n                    overall_difficulty={result.overall_difficulty}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    _fetchFirstResultReviews = (id) => {\r\n        const {entity} = this.props.match.params\r\n\r\n        fetch(`http://localhost:8000/api/${entity}/${id}/reviews`)\r\n        .then(res => res.json())\r\n        .then(first_result_reviews => {\r\n            this.setState({first_result_reviews})\r\n        }) \r\n    }\r\n\r\n    _renderFirstResultReviews = () => {\r\n        const {first_result_reviews} = this.state\r\n        if (first_result_reviews.length === 0) {\r\n            return (\r\n                <div>Sin reseñas</div>\r\n            );\r\n        }\r\n        else {\r\n            return first_result_reviews.map( review => {\r\n                return (\r\n                    <ReviewInResults \r\n                        key={review.id}\r\n                        id={review.id}\r\n                        text={review.text}\r\n                        rating={review.rating}\r\n                        difficulty={review.difficulty}\r\n                        date={review.date}\r\n                        user_name={review.user_name}\r\n                        entity={review.entity}\r\n                        entity_name={review.entity_name}\r\n                        entity_type={review.entity_type}\r\n                    />\r\n                    );\r\n            })\r\n        }\r\n    }\r\n\r\n    render() {\r\n        const {entity} = this.props.match.params\r\n        const {results, first_result_name} = this.state\r\n\r\n        return (\r\n            <div>\r\n                <div className=\"columns is-multiline m-2\">\r\n                    { \r\n                        entity === \"profesores\"\r\n                        ? \r\n                            <div className=\"column is-one-quarter\">\r\n                                {this._renderProfessorsResults()}\r\n                            </div>\r\n                        :   \r\n                            entity === \"universidades\"\r\n                            ?\r\n                                this._renderUniversitiesResults()\r\n                            :\r\n                                entity === \"escuelas\"\r\n                                ?\r\n                                    this._renderSchoolsResults()\r\n                                :\r\n                                    <div>Eliga una categoria de búsqueda</div>\r\n                    }\r\n                </div>\r\n                {results.length !== 0\r\n                ?   <React.Fragment>\r\n                        <hr className=\"horizontal-line\"/>\r\n                        <div className=\"m-3 ml-5\">\r\n                            <h5 className=\"title is-5\">Ultimas reseñas sobre {first_result_name}</h5>\r\n                        </div>\r\n                        <div className=\"columns is-multiline m-2 mt-5\">\r\n                            {this._renderFirstResultReviews()} \r\n                        </div>\r\n                    </React.Fragment>\r\n                :\r\n                    <React.Fragment />\r\n                }\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RedirectAs404.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Profile.js",["332"],"import React, {Component} from 'react'\r\nimport {Switch, Route} from 'react-router-dom'\r\nimport {ProfileNavBar} from './ProfileNavBar'\r\nimport ReviewsList from '../review/ReviewsList'\r\nimport SchoolsList from '../school/SchoolsList'\r\nimport ProfessorsList from '../professor/ProfessorsList'\r\nimport {RedirectAs404} from './RedirectAs404'\r\nimport RightPanel from './RightPanel'\r\n\r\nexport class Profile extends Component {\r\n\r\n    state = {\r\n        entity:\"\"\r\n    }\r\n\r\n    render () {\r\n        const {entity} = this.props\r\n        const {id} = this.props.match.params\r\n        return (\r\n            <div className=\"columns\">\r\n                <div className=\"column is-two-thirds\">\r\n                    <div className=\"columns mt-2 is-multiline\">\r\n                        <div className=\"column is-four-fifths is-offset-1\">\r\n                            {/* DETALLES */}\r\n                            {this.props.children}\r\n                        </div>\r\n                        <div className=\"column is-12\">\r\n                            {/* BARRA DE NAVEGACION */}\r\n                            <ProfileNavBar \r\n                                subject={entity} \r\n                                url={this.props.match.url} \r\n                                location={this.props.location}\r\n                            />\r\n                        </div>\r\n                        {/* LISTAS */}\r\n                        <Switch>\r\n                            <Route  \r\n                                exact\r\n                                path={this.props.match.path}\r\n                                render={(props) => (\r\n                                    <div className=\"column is-four-fifths is-offset-1 mt-2\">\r\n                                        <ReviewsList {...props} entity={entity}/>\r\n                                    </div>\r\n                                )} \r\n                            />\r\n                            {entity === \"universidades\" || entity ===\"escuelas\"\r\n                                ?   <Route \r\n                                        path={this.props.match.path + \"/profesores\"}\r\n                                        render={(props) => (\r\n                                            <div className=\"column is-two-fifths is-offset-1\">\r\n                                                <ProfessorsList {...props} entity={entity}/>\r\n                                            </div>\r\n                                        )} \r\n                                    />\r\n                                :   <Route component={RedirectAs404}/>\r\n                                }\r\n                            {entity === \"universidades\" \r\n                                ?   <Route \r\n                                        path={this.props.match.path + \"/escuelas\"}\r\n                                        render={(props) => (\r\n                                            <div className=\"column is-four-fifths is-offset-1 mt-2\">\r\n                                                <SchoolsList {...props} />\r\n                                            </div>\r\n                                        )} \r\n                                    />\r\n                                :   <Route component={RedirectAs404}/>\r\n                            }\r\n                            <Route component={RedirectAs404}/>\r\n                        </Switch>\r\n                    </div>\r\n                </div>\r\n                {/* PANEL DERECHO */}\r\n                <RightPanel/>\r\n            </div>\r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\RightPanel.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\ProfileNavBar.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MasterWrapper.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\store.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\util.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\index.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\authReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\errorReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\types.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\authActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\errorActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\PrivateRoute.js",["333"],"import React from 'react'\r\nimport {Route, Redirect} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\n\r\nconst PrivateRoute = ({ component: Component, auth, ...rest}) =>(\r\n    <Route \r\n        {...rest}\r\n        render= {(props) => {\r\n            if (auth.isLoading) {\r\n                return <div>Cargando...RUTA PRIVADA</div>\r\n            }\r\n            else if (!auth.isAuthenticated) {\r\n                return <Redirect to=\"/iniciar-sesion\"/>\r\n            }\r\n            else {\r\n                return <Component {...props}/>\r\n            }\r\n        }}\r\n    />\r\n);\r\n\r\n\r\nconst mapStateToProps = (state) => ({\r\n    auth: state.auth\r\n})\r\n\r\nexport default connect(mapStateToProps)(PrivateRoute)","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\reviewReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\reviewActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityDetailsReducer.js",["334","335"],"import {\r\n    ENTITY_LOADING,\r\n    GET_ENTITY,\r\n    CLEAR_ENTITY,\r\n    REVIEW_BY_USER_LOADED,\r\n    CLEAR_REVIEW_BY_USER,\r\n    SUBSCRIBE_TO_ENTITY\r\n} from '../actions/types'\r\n\r\nconst initialState = {\r\n    entity: {},\r\n    entityIsLoading: false,\r\n    reviewByUser: {},\r\n}\r\n\r\nexport const entityDetailsReducer = (state=initialState, action) => {\r\n    switch(action.type){\r\n        case ENTITY_LOADING:\r\n            return {\r\n                ...state,\r\n                entityIsLoading: true\r\n            }\r\n        case GET_ENTITY:\r\n            return {\r\n                ...state,\r\n                entity: action.payload,\r\n                entityIsLoading: false\r\n            }\r\n        case CLEAR_ENTITY:\r\n            return {\r\n                ...state,\r\n                entity: {}\r\n            }\r\n        case SUBSCRIBE_TO_ENTITY:\r\n            return {\r\n                ...state,\r\n                entity: action.payload\r\n            }\r\n        default:\r\n            return state\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityDetailsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\EditReview.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserListReviews.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\notificationReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\Notification.js",["336","337"],"import React, {Component} from 'react'\r\nimport {FaTrashAlt} from 'react-icons/fa'\r\nimport {AiOutlineCheck} from 'react-icons/ai'\r\nimport {GoPrimitiveDot} from 'react-icons/go'\r\nimport {MdKeyboardArrowRight} from 'react-icons/md'\r\nimport {connect} from 'react-redux'\r\nimport {checkNotification, deleteNotification} from '../actions/notificationsActions'\r\nimport PropTypes from 'prop-types'\r\n\r\nexport class Notification extends Component {\r\n\r\n    static propTypes = {\r\n        deleteNotification: PropTypes.func.isRequired,\r\n        checkNotification: PropTypes.func.isRequired,\r\n    }\r\n\r\n    _handleDelete = () => {\r\n        this.props.deleteNotification(this.props.id)\r\n    }\r\n\r\n    _handleCheck = () => {\r\n        this.props.checkNotification(this.props.id)\r\n    }\r\n\r\n    render() {\r\n\r\n        const {id, message, check, date} = this.props\r\n\r\n        return (\r\n            <div className=\"pt-2 pb-2 pl-4 pr-4 list-border-bottom\">\r\n                <div className=\"columns is-mobile\">\r\n                    <div className=\"column is-10-desktop is-8-mobile is-9-tablet\">\r\n                        {   \r\n                            !check ?\r\n                            <GoPrimitiveDot className=\"has-text-link\"/> :\r\n                            \"\"\r\n                        }\r\n                        {message} \r\n                    </div>\r\n                    <div className=\"column has-text-centered is-1-desktop\">\r\n                        <span className=\"has-text-warning-dark\">\r\n                            {\r\n                                !check ?\r\n                                <AiOutlineCheck\r\n                                    onClick={this._handleCheck}\r\n                                    className=\"custom-icon is-size-6\" \r\n                                /> :\r\n                                <MdKeyboardArrowRight\r\n                                    onClick={this._handleCheck}\r\n                                    className=\"custom-icon is-size-6\" \r\n                                />\r\n                            }\r\n                        </span>\r\n                    </div>\r\n                    <div className=\"column has-text-centered is-1-desktop\">\r\n                        <span className=\"has-text-danger-dark\">\r\n                            <FaTrashAlt \r\n                                onClick={this._handleDelete}\r\n                                className=\"custom-icon is-size-6\" \r\n                            />\r\n                        </span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}\r\n\r\n\r\nexport default connect(null, {checkNotification, deleteNotification})(Notification);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\notificationsActions.js",["338"],"import {GET_NOTIFICATIONS, DELETE_NOTIFICATION, CHECK_NOTIFICATION, CLEAR_NOTIFICATIONS, GET_ERRORS} from './types'\r\nimport {tokenConfig, getUser} from './authActions'\r\nimport axios from 'axios'\r\n\r\nexport const getNotifications = () => (dispatch, getState) => {\r\n    // Petición HTTP a la API para obtener notificaciones del usuario autenticado.\r\n    axios.get(`http://localhost:8000/api/notificaciones/`, tokenConfig(getState))\r\n    .then( res => {\r\n        dispatch({ \r\n            type: GET_NOTIFICATIONS,\r\n            payload: res.data\r\n        });\r\n    })\r\n    .catch( e => {\r\n        const errors = {message: e.response.data, status: e.response.status}\r\n        dispatch( {\r\n            type: GET_ERRORS,\r\n            payload: errors\r\n        })\r\n    })\r\n}\r\n\r\nexport const deleteNotification = (id) => (dispatch, getState) => {\r\n    // Petición HTTP a la API para borrar notificacione del usuario autenticado.\r\n    axios.delete(`http://localhost:8000/api/notificaciones/${id}/`, tokenConfig(getState))\r\n    .then( res => {\r\n        dispatch({ \r\n            type: DELETE_NOTIFICATION,\r\n            payload: id\r\n        });\r\n    })\r\n    .catch( e => {\r\n        const errors = {message: e.response.data, status: e.response.status}\r\n        dispatch( {\r\n            type: GET_ERRORS,\r\n            payload: errors\r\n        })\r\n    })\r\n}\r\n\r\nexport const checkNotification = (id) => (dispatch, getState) => {\r\n    // Petición HTTP a la API para borrar notificacione del usuario autenticado.\r\n    axios.get(`http://localhost:8000/api/notificaciones/${id}/check_notification/`, tokenConfig(getState))\r\n    .then( res => {\r\n        dispatch({ \r\n            type: CHECK_NOTIFICATION,\r\n            payload: res.data\r\n        });\r\n    })\r\n    .catch( e => {\r\n        const errors = {message: e.response.data, status: e.response.status}\r\n        dispatch( {\r\n            type: GET_ERRORS,\r\n            payload: errors\r\n        })\r\n    })\r\n}\r\n\r\n\r\nexport const clearNotifications = () => (dispatch) => {\r\n    dispatch({\r\n        type: CLEAR_NOTIFICATIONS\r\n    })\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\userFeedReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\userFeedActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\entityReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\entityActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\LikelyProfessor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\LikelyProfessorsList.js",["339"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {LikelyProfessor} from './LikelyProfessor'\r\nimport {connect} from 'react-redux'\r\nimport {getLikelyProfessors, clearLikelyProfessors} from '../actions/authActions'\r\nimport PropTypes from 'prop-types'\r\n\r\nexport class LikelyProfessorsList extends Component { \r\n\r\n    static propTypes = {\r\n        auth: PropTypes.object.isRequired,\r\n        getLikelyProfessors: PropTypes.func.isRequired,\r\n        clearLikelyProfessors: PropTypes.func.isRequired,\r\n    }\r\n\r\n    componentDidMount() {\r\n        this.props.getLikelyProfessors()\r\n    }\r\n\r\n    componentDidUpdate(prevProps){\r\n        const {auth} = this.props\r\n        if(prevProps.auth.user){\r\n            if(prevProps.auth.user.school !== auth.user.school){\r\n                this.props.getLikelyProfessors()\r\n            }\r\n        }\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        // Limpiar entidades cargadas\r\n        this.props.clearLikelyProfessors()\r\n    }\r\n\r\n    _renderProfessors = () => {\r\n        const {likelyProfessors} = this.props.auth\r\n\r\n        if(likelyProfessors.length === 0) {\r\n            return (\r\n                <div className=\"has-text-centered mt-6 mb-6 pt-6 pb-6\">\r\n                    <p className=\"ml-2 mr-2 mt-3 mb-3\">\r\n                        Elige tu universidad y escuela para ver profesores probables\r\n                    </p>\r\n                </div>\r\n            );\r\n        }\r\n        else {\r\n            return likelyProfessors.map( professor => {\r\n                return (\r\n                    <LikelyProfessor \r\n                        key={professor.id}\r\n                        id={professor.id} \r\n                        name={professor.name}\r\n                        reviews_count={professor.reviews_count}\r\n                    />\r\n                );\r\n            })\r\n        }\r\n    }\r\n\r\n    render () {\r\n\r\n        // const {error} = this.props\r\n\r\n        return (\r\n            <div className=\"columns is-multiline side-list m-6\">\r\n                <div className=\"column list-border-bottom has-text-centered\">\r\n                    <p className=\"black-title has-text-weight-bold big-text\">Conoces o Conoceras</p>\r\n                </div>\r\n                {\r\n                    this.props.auth.loadingProfessors ?\r\n                    <React.Fragment>\r\n                        <div className=\"column is-full has-text-centered list-border-bottom pt-3 pb-3\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                        <div className=\"column is-full has-text-centered list-border-bottom pt-3 pb-3\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                        <div className=\"column is-full has-text-centered list-border-bottom pt-3 pb-3\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                        <div className=\"column is-full has-text-centered list-border-bottom pt-3 pb-3\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                    </React.Fragment>\r\n                    :\r\n                    this._renderProfessors()\r\n                }\r\n                <div className=\"column is-full has-text-centered has-text-link\">\r\n                    {/* <Link to={this.see_more_url}> */}\r\n                        Ver más\r\n                    {/* </Link> */}\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    auth : state.auth,\r\n    error: state.error\r\n  });\r\n  \r\nexport default connect(mapStateToProps, {getLikelyProfessors, clearLikelyProfessors})(LikelyProfessorsList);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\UserSettings.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\professor\\SubscriptionProfessor.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\school\\SubscriptionSchool.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\university\\SubscriptionUniversity.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\user\\SubscriptionsList.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\subscriptionsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\subscriptionsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPassword.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPasswordConfirmation.js",["340","341"],"import React, {Component} from 'react'\r\nimport logoicono from '../../logo-icono.png'\r\nimport {Redirect, Link} from 'react-router-dom'\r\nimport {connect} from 'react-redux'\r\nimport PropTypes from 'prop-types'\r\nimport {resetPasswordConfirm} from '../actions/authActions'\r\nimport {clearErrors} from '../actions/errorActions'\r\n\r\nexport class ResetPasswordConfirmation extends Component {\r\n\r\n    state = {\r\n        uid: '',\r\n        token: '',\r\n        new_password: '',\r\n    }\r\n\r\n    static propTypes = {\r\n        isAuthenticated: PropTypes.bool,\r\n        error: PropTypes.object.isRequired,\r\n        resetPasswordConfirm: PropTypes.func.isRequired,\r\n        clearErrors: PropTypes.func.isRequired,\r\n    }\r\n\r\n    _handleSubmit = (e) => {\r\n        e.preventDefault();\r\n        const {uid, token, new_password} = this.state\r\n        this.props.resetPasswordConfirm(uid, token, new_password)\r\n    }\r\n\r\n    _handleChange = (e) => {\r\n        this.setState({ [e.target.name]: e.target.value });\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearErrors()\r\n    }\r\n\r\n    render () {\r\n        if (this.props.isAuthenticated){\r\n            return <Redirect to=\"/\" />\r\n        }\r\n\r\n        const {email} = this.state\r\n        const {error} = this.props\r\n\r\n        return (\r\n            <section className=\"section pt-3\">\r\n            <div className=\"container\">\r\n            <div className=\"columns is-centered\">\r\n            <div className=\"column is-two-fifths\">\r\n                <div className=\"has-text-centered\">\r\n                    <img src={logoicono} alt=\"logoicono\" width=\"100\" height=\"100\"/>\r\n                </div>\r\n                <div>\r\n                    <div className=\"ml-2 mr-5 mb-5 mt-0\">\r\n                        <h4 className=\"title is-4\">Ingresa tu nueva contraseña</h4>\r\n                    </div>\r\n                    <form onSubmit={this._handleSubmit}>\r\n                        <div className=\"field\">\r\n                            <p className=\"control\">\r\n                                <input\r\n                                    className=\"input is-medium\"\r\n                                    type=\"password\"\r\n                                    placeholder=\"nueva contraseña\"\r\n                                    name=\"new_password\"\r\n                                    onChange={this._handleChange}\r\n                                />\r\n                            </p>\r\n                            <p className=\"has-text-danger\">\r\n                                {error.message.new_password ? error.message.new_password : '' }\r\n                            </p>\r\n                        </div>\r\n                        <div className=\"field mt-5 is-grouped is-grouped-centered\">\r\n                            <div className=\"buttons\">\r\n                                <button type=\"submit\" className=\"button is-link is-medium has-text-white has-text-weight-bold\">\r\n                                    Cambiar contraseña\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n            </div>\r\n            </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    isAuthenticated : state.auth.isAuthenticated,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(mapStateToProps, { resetPasswordConfirm, clearErrors })(ResetPasswordConfirmation);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Embed.js",["342"],"import React, {Component} from 'react'\r\nimport Review from './Review'\r\nimport RightPanel from '../common/RightPanel'\r\nimport {connect} from 'react-redux'\r\nimport {getReview, clearReview} from '../actions/reviewActions'\r\nimport PropTypes from 'prop-types'\r\nimport {RedirectAs404} from '../common/RedirectAs404'\r\n\r\n\r\nexport class Embed extends Component {\r\n\r\n    static propTypes = {\r\n        getReview: PropTypes.func.isRequired,\r\n        review: PropTypes.object.isRequired,\r\n        isLoading: PropTypes.bool,\r\n        clearReview: PropTypes.func.isRequired,\r\n        error: PropTypes.object.isRequired,\r\n    }\r\n\r\n    componentDidMount() {\r\n        const {id} = this.props.match.params\r\n        this.props.getReview(id)\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearReview()\r\n    }\r\n\r\n    render() {\r\n\r\n        if (this.props.error.status === 404) {\r\n            return <RedirectAs404 location={this.props.location}/>\r\n        }\r\n\r\n        const {review} = this.props\r\n\r\n        return(\r\n        <div className=\"columns is-centered mt-6 pt-6 ml-0 mr-0\">\r\n            <div className=\"column is-full\">\r\n                {\r\n                    this.props.isLoading ?\r\n                    <div className=\"columns\">\r\n                        <div className=\"column has-text-centered\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                    </div> :\r\n                    <Review \r\n                        id={review.id}\r\n                        text={review.text}\r\n                        rating={review.rating}\r\n                        difficulty={review.difficulty}\r\n                        date={review.date}\r\n                        user={review.user}\r\n                        user_name={review.user_name}\r\n                        entity={review.entity}\r\n                        entity_name={review.entity_name}\r\n                        entity_type={review.entity_type}\r\n                        recomendations_count={review.recomendations_count}\r\n                        recomendations={review.recomendations}\r\n                        favorite={review.favorite}\r\n                    />\r\n                }\r\n            </div>\r\n        </div>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    review: state.reviews.review,\r\n    isLoading: state.reviews.isLoading,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(\r\n    mapStateToProps, \r\n    {getReview, clearReview}\r\n)(Embed);","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewDetail.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MenuMobile.js",["343"],"import React, {Component} from 'react'\r\nimport {Link} from 'react-router-dom'\r\nimport {GiHamburgerMenu} from 'react-icons/gi'\r\nimport {VscHome} from 'react-icons/vsc'\r\nimport {BsPersonLinesFill, BsBuilding} from 'react-icons/bs'\r\nimport {BiNews} from 'react-icons/bi'\r\nimport {MdLibraryBooks} from 'react-icons/md' \r\n\r\nexport class MenuMobile extends Component {\r\n\r\n    state = {\r\n        section: null\r\n    }\r\n\r\n    componentDidMount(){\r\n        const path = this.props.location.pathname.split(\"/\")\r\n        this.setState({ \r\n            section: path[path.length-1] \r\n        })\r\n    }\r\n\r\n    componentDidUpdate(prevPros){\r\n        if(prevPros.location.pathname !== this.props.location.pathname){\r\n            const path = this.props.location.pathname.split(\"/\")\r\n            this.setState({ \r\n                section: path[path.length-1] \r\n            })\r\n        }\r\n    }\r\n\r\n    render () {\r\n        return (\r\n            <nav className=\"navbar is-fixed-bottom columns is-mobile menu-mobile has-text-centered\">\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/'\r\n                        className={this.state.section === \"\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <VscHome size={24}/>\r\n                        </div>\r\n                    </Link> \r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/feed'\r\n                        className={this.state.section === \"feed\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <BiNews size={24} />\r\n                        </div>\r\n                    </Link>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/biblioteca'\r\n                        className={this.state.section === \"favoritas\" || this.state.section === \"recomendadas\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <MdLibraryBooks size={24} />\r\n                        </div>\r\n                    </Link>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to=\"/instituciones\"\r\n                        className={this.state.section === \"instituciones\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <BsBuilding size={24} />\r\n                        </div>\r\n                    </Link>\r\n                </div>\r\n                <div className=\"column\">\r\n                    <Link \r\n                        to='/profesores'\r\n                        className={this.state.section === \"profesores\" ? \"menu-active\" : \"\"}\r\n                    >\r\n                        <div className=\"centered-label icon\">\r\n                            <BsPersonLinesFill size={24} />\r\n                        </div>\r\n                    </Link> \r\n                </div>\r\n            </nav>     \r\n        );\r\n    }\r\n}","C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Page404.js",[],{"ruleId":"344","replacedBy":"345"},{"ruleId":"346","replacedBy":"347"},{"ruleId":"348","severity":1,"message":"349","line":20,"column":