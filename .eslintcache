"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\subscriptionsReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\subscriptionsActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPassword.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\accout\\ResetPasswordConfirmation.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\Embed.js",["331"],"import React, {Component} from 'react'\r\nimport Review from './Review'\r\nimport RightPanel from '../common/RightPanel'\r\nimport {connect} from 'react-redux'\r\nimport {getReview, clearReview} from '../actions/reviewActions'\r\nimport PropTypes from 'prop-types'\r\nimport {RedirectAs404} from '../common/RedirectAs404'\r\n\r\n\r\nexport class Embed extends Component {\r\n\r\n    static propTypes = {\r\n        getReview: PropTypes.func.isRequired,\r\n        review: PropTypes.object.isRequired,\r\n        isLoading: PropTypes.bool,\r\n        clearReview: PropTypes.func.isRequired,\r\n        error: PropTypes.object.isRequired,\r\n    }\r\n\r\n    componentDidMount() {\r\n        const {id} = this.props.match.params\r\n        this.props.getReview(id)\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        this.props.clearReview()\r\n    }\r\n\r\n    render() {\r\n\r\n        if (this.props.error.status === 404) {\r\n            return <RedirectAs404 location={this.props.location}/>\r\n        }\r\n\r\n        const {review} = this.props\r\n\r\n        return(\r\n        <div className=\"columns is-centered mt-6 pt-6 ml-0 mr-0\">\r\n            <div className=\"column is-full\">\r\n                {\r\n                    this.props.isLoading ?\r\n                    <div className=\"columns\">\r\n                        <div className=\"column has-text-centered\">\r\n                            <button className=\"button is-link is-loading\">Loading</button>\r\n                        </div>\r\n                    </div> :\r\n                    <Review \r\n                        id={review.id}\r\n                        text={review.text}\r\n                        rating={review.rating}\r\n                        difficulty={review.difficulty}\r\n                        date={review.date}\r\n                        user={review.user}\r\n                        user_name={review.user_name}\r\n                        entity={review.entity}\r\n                        entity_name={review.entity_name}\r\n                        entity_type={review.entity_type}\r\n                        recomendations_count={review.recomendations_count}\r\n                        recomendations={review.recomendations}\r\n                        favorite={review.favorite}\r\n                    />\r\n                }\r\n            </div>\r\n        </div>\r\n        );\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => ({\r\n    review: state.reviews.review,\r\n    isLoading: state.reviews.isLoading,\r\n    error: state.error\r\n});\r\n\r\nexport default connect(\r\n    mapStateToProps, \r\n    {getReview, clearReview}\r\n)(Embed);",["332","333"],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\review\\ReviewDetail.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\MenuMobile.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\Page404.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\reducers\\messageReducer.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\actions\\messageActions.js",[],"C:\\Users\\Lenovo\\Desktop\\Git\\agenteu-frontend\\src\\components\\common\\terms.js",[],{"ruleId":"334","replacedBy":"335"},{"ruleId":"336","replacedBy":"337"},{"ruleId":"338","severity":1,"message":"339","line":3,"column":8,"nodeType":"340","messageId":"341","endLine":3,"endColumn":18},{"ruleId":"334","replacedB